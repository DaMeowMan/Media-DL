#!/bin/sh
# (media-dl-setup is already gone when postrm runs, so clean up inline)
set -e
case "$1" in
remove|purge)
    rm -rf /opt/media-dl/venv /opt/media-dl/.uv-bootstrap
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q || true
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -f -t /usr/share/icons/hicolor || true
    ;;
esac
case "$1" in
purge)
    rm -rf /opt/media-dl
    if grep -q '^# media-dl:' /etc/yt-dlp.conf 2>/dev/null; then rm -f /etc/yt-dlp.conf; fi
    ;;
esac
exit 0
