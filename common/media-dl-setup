#!/bin/sh
# media-dl-setup - build (or remove) the media-dl virtualenv with uv.
#
#   media-dl-setup            create/rebuild the venv and install everything
#   media-dl-setup --remove   delete the venv
#   media-dl-setup --purge    delete the venv, generated yt-dlp config, app dir
#
# Environment overrides:
#   MEDIA_DL_APP          app dir                (default /opt/media-dl)
#   MEDIA_DL_VENV         venv dir               (default $MEDIA_DL_APP/venv)
#   MEDIA_DL_YTDLP_CONF   yt-dlp config to write (default /etc/yt-dlp.conf)
#   MEDIA_DL_PYTHON       python to build with   (default: python3 on PATH)
set -e

APP="${MEDIA_DL_APP:-/opt/media-dl}"
VENV="${MEDIA_DL_VENV:-$APP/venv}"
CONF="${MEDIA_DL_YTDLP_CONF:-/etc/yt-dlp.conf}"
PYTHON="${MEDIA_DL_PYTHON:-$(command -v python3 || true)}"
MARK="# media-dl:"

case "${1:-}" in
--remove)
    rm -rf "$VENV" "$APP/.uv-bootstrap"
    exit 0 ;;
--purge)
    rm -rf "$VENV" "$APP/.uv-bootstrap"
    if grep -q "^$MARK" "$CONF" 2>/dev/null; then rm -f "$CONF"; fi
    rmdir "$APP" 2>/dev/null || true
    exit 0 ;;
esac

[ -n "$PYTHON" ] || { echo "media-dl: python3 not found" >&2; exit 1; }
mkdir -p "$APP"

# 1) find uv, or bootstrap a throw-away copy from PyPI
UV="$(command -v uv || true)"
BOOT=""
if [ -z "$UV" ]; then
    echo "media-dl: uv not found, bootstrapping it from PyPI..."
    BOOT="$APP/.uv-bootstrap"
    rm -rf "$BOOT"
    "$PYTHON" -m venv "$BOOT"
    "$BOOT/bin/pip" install --quiet --disable-pip-version-check uv
    UV="$BOOT/bin/uv"
fi

export UV_PYTHON_DOWNLOADS=never   # always use the system python
export UV_LINK_MODE=copy           # avoid cross-filesystem hardlink warnings

# 2) venv (system-site-packages so the distro's Pillow/ImageTk is visible;
#    tkinter is stdlib and works either way)
rm -rf "$VENV"
"$UV" venv --system-site-packages --python "$PYTHON" "$VENV"

pipi()    { "$UV" pip install --python "$VENV/bin/python" "$@"; }
try_pip() { pipi "$@" || echo "media-dl: optional install failed: $*"; }

# 3) core deps (must succeed). yt-dlp[curl-cffi] is required for browser
#    impersonation; the extra pins a curl_cffi version yt-dlp supports.
pipi "yt-dlp[curl-cffi]" gallery-dl python-mpv mutagen requests pyyaml websockets
if ! "$VENV/bin/python" -c "import curl_cffi" 2>/dev/null; then
    echo "media-dl: curl_cffi (yt-dlp impersonation) failed to install on $(uname -m)" >&2
    exit 1
fi
echo "media-dl: impersonation targets:"
"$VENV/bin/yt-dlp" --list-impersonate-targets 2>&1 | head -20 || true

# 4) everything optional for yt-dlp, one by one so a missing wheel only skips
#    that one (distro packages act as fallback via system-site-packages)
try_pip "yt-dlp[default]"          # brotli, certifi, mutagen, pycryptodomex, requests, urllib3, websockets, yt-dlp-ejs
try_pip "yt-dlp[secretstorage]"    # --cookies-from-browser keyring access
try_pip xattr                      # --xattrs
for p in pysocks toml jinja2 truststore; do try_pip "$p"; done   # gallery-dl extras

# 5) JavaScript runtime for YouTube (yt-dlp-ejs needs deno, node>=22 or quickjs)
[ -x "$VENV/bin/deno" ] || try_pip deno
if ! [ -x "$VENV/bin/deno" ] && ! [ -x "$VENV/bin/node" ]; then
    try_pip nodejs-wheel-binaries
fi
RUNTIME=""
if [ -x "$VENV/bin/deno" ]; then
    RUNTIME="deno:$VENV/bin/deno"
elif [ -x "$VENV/bin/node" ]; then
    RUNTIME="node:$VENV/bin/node"
elif command -v node >/dev/null 2>&1 \
     && [ "$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)" -ge 22 ]; then
    RUNTIME="node:$(command -v node)"
fi
if [ -n "$RUNTIME" ]; then
    # absolute path: mpv's ytdl hook runs yt-dlp without the venv on PATH
    if [ ! -e "$CONF" ] || grep -q "^$MARK" "$CONF"; then
        mkdir -p "$(dirname "$CONF")"
        printf '%s generated by the media-dl package\n--js-runtimes %s\n' "$MARK" "$RUNTIME" > "$CONF"
    else
        echo "media-dl: $CONF exists; add '--js-runtimes $RUNTIME' to it yourself"
    fi
else
    echo "media-dl: no JS runtime (deno / node>=22) found; YouTube may fail until you install one"
fi

# keep uv inside the venv for media-dl-update, drop the bootstrap copy
if [ -n "$BOOT" ]; then
    pipi uv || true
    rm -rf "$BOOT"
fi

if [ "$(id -u)" = 0 ]; then chmod -R a+rX "$APP"; fi
echo "media-dl: setup finished ($VENV)"
